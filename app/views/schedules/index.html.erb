<p style="color: green"><%= notice %></p>
<% content_for :title, "Schedules" %>
<h2>予定一覧</h2>
<div class="index-header">
  <%= link_to "新規作成", new_schedule_path ,class: "btn_NewSchedules" %>
</div>
<table class="index-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.strftime("%Y/%m/%d") %></td>
        <td><%= schedule.end_date.strftime("%Y/%m/%d") %></td>
        <td><%= schedule.all_day ? "〇" : "" %></td>
        <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%= link_to "詳細", schedule %></td>
        <td><%= link_to "編集", edit_schedule_path(schedule) %></td>
        <td><%= link_to "削除", schedule, data: { turbo_method: :delete, turbo_confirm: "予定を削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <p>予定の合計数: <strong><%= @schedules.count %></strong>件</p>
  <p class="today-date">本日の日付 <%=Date.today.strftime("%Y/%m/%d") %></p>
</div>